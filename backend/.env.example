# Backend Environment Variables Example (.env.example)
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
# Optional: Set DATABASE_URL to connect to Cloud PostgreSQL (Supabase / Neon / Render).
# If DATABASE_URL is omitted, backend defaults to local embedded SQLite database.
DATABASE_URL=postgresql://username:password@hostname:5432/dbname
CLIENT_ORIGIN=https://your-frontend-app.vercel.app
